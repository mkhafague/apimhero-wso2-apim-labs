# Fichier d'environnement des labs — copiez-le en `.env` (même dossier) :
#   cp labs/.env.example labs/.env
# Docker Compose le lit automatiquement. COMPOSE_PROFILES définit le profil actif
# quand vous ne passez pas --profile sur la ligne de commande.
# Profils disponibles : core (API Manager seul), apps (backends petstore/invoices),
# iam (Identity Server), staging (second API Manager), integration (Micro Integrator).
COMPOSE_PROFILES=core
